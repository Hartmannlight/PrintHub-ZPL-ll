{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Printers config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "printers"],
  "properties": {
    "config_version": {
      "const": 1
    },
    "printers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/printer"
      },
      "default": []
    }
  },
  "$defs": {
    "printer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "model",
        "vendor",
        "driver",
        "connection",
        "media",
        "alignment",
        "defaults",
        "capabilities",
        "enabled"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "driver": { "type": "string", "minLength": 1 },
        "connection": { "$ref": "#/$defs/connection" },
        "media": { "$ref": "#/$defs/media" },
        "alignment": { "$ref": "#/$defs/alignment" },
        "zpl": { "$ref": "#/$defs/zpl" },
        "driver_options": {
          "type": "object",
          "description": "Opaque, driver-owned settings. Core services must not interpret these values.",
          "additionalProperties": true
        },
        "defaults": { "$ref": "#/$defs/defaults" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "enabled": { "type": "boolean" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol"],
      "properties": {
        "protocol": { "enum": ["raw9100", "zebra_tamer", "driver_agent"] },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "base_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "printer_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" }
      },
      "oneOf": [
        {
          "properties": { "protocol": { "const": "raw9100" } },
          "required": ["host", "port", "timeout_ms"]
        },
        {
          "properties": { "protocol": { "const": "zebra_tamer" } },
          "required": ["base_url", "printer_id", "timeout_ms"]
        },
        {
          "properties": { "protocol": { "const": "driver_agent" } },
          "required": ["base_url", "printer_id", "timeout_ms"]
        }
      ]
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loaded"],
      "properties": {
        "loaded": { "$ref": "#/$defs/media_loaded" },
        "dynamic_source": { "$ref": "#/$defs/media_dynamic_source" }
      }
    },
    "media_dynamic_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": { "const": "zpl_emulator_settings" },
        "url": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 10000 }
      }
    },
    "media_loaded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_mm", "height_mm", "color", "type"],
      "properties": {
        "width_mm": { "type": "number", "exclusiveMinimum": 0 },
        "height_mm": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dpi", "offset_x_mm", "offset_y_mm"],
      "properties": {
        "dpi": { "type": "integer", "minimum": 1 },
        "offset_x_mm": { "type": "number" },
        "offset_y_mm": { "type": "number" }
      }
    },
    "zpl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "darkness": { "type": "integer", "minimum": 0 },
        "print_speed": { "type": "integer", "minimum": 0 },
        "print_mode": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copies", "rotation"],
      "properties": {
        "copies": { "type": "integer", "minimum": 1 },
        "rotation": { "enum": [0, 90, 180, 270] }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports_status", "supports_graphics", "supports_cut"],
      "properties": {
        "supports_status": { "type": "boolean" },
        "supports_graphics": { "type": "boolean" },
        "supports_cut": { "type": "boolean" }
      }
    }
  }
}

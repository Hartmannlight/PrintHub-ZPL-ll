{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://printhub.local/contracts/print-service-v2/error.schema.json",
  "title": "Print service v2 error",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    }
  }
}

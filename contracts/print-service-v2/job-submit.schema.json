{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://printhub.local/contracts/print-service-v2/job-submit.schema.json",
  "title": "Print service v2 job submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["idempotency_key", "artifacts", "copies"],
  "properties": {
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "maxLength": 1000 },
    "media_revision": { "type": ["string", "null"] },
    "copies": { "type": "integer", "minimum": 1, "maximum": 999 },
    "reprint_of": { "type": ["string", "null"], "maxLength": 200 },
    "options": { "type": "object", "default": {} },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mime_type", "sha256", "data_base64"],
        "properties": {
          "mime_type": {
            "enum": ["application/zpl", "application/vnd.printhub.raster-page+json"]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "data_base64": { "type": "string", "minLength": 1, "contentEncoding": "base64" }
        }
      }
    }
  }
}
